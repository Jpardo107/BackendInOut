# Google Places API (New). Mantener estos valores solo en el backend.
GOOGLE_PLACES_API_KEY=tu_api_key
GOOGLE_PLACE_ID=tu_place_id
# Opcional: 6 horas por defecto.
GOOGLE_REVIEWS_CACHE_SECONDS=21600

# Private guard lookup for RondApp (same value in both backends).
RONDAPP_INTEGRATION_KEY=

# Orígenes autorizados para el formulario comercial de la web pública.
CONTACT_ALLOWED_ORIGINS=https://www.inout.cl,https://inout.cl

# SMTP se comparte con el sistema de notificaciones existente.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=contacto@inout.cl
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=contacto@inout.cl
